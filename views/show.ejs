    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <title>Cadastro</title>
        <link rel="stylesheet" href="/style.css">
        <link rel="stylesheet" href="icon" type="image/png" href="/logo.png (2).png">
        <link rel="stylesheet" href="/style.css">
    </head>


      <header>
        <img class="logo" src="/logo.png (2).png" alt='logo guardalink'>
        <h1>Api Crud</h1>
        <p>Node.js + espress + ejs + MongoDB</p>
        
    </header>


    <body><div class="container">
        <h2><center>Cadastros</center></h2>
        <form>
        <table border="1">
            
            <thead>
                <tr>
                    <td>Nome Completo</td>
                    <td>E-mail</td>
                    <td>Ação</td>
                </tr>
            </thead>
            <tbody>
                <% crud.forEach(function(details) { %>
                    <tr>
                        <td><%= details.nomeCompleto %></td>
                        <td><%= details.email %></td>
                        
                        <td><a href="/edit/<%= details._id %>">Alterar</a> - 
                            <a href="/delete/<%= details._id %>">Deletar</a></td>
                    </tr>
                    <% }) %>
            </tbody></form></div>
        </table> <button><a href="/index">Criar Novo Cadastro</a></button>
    </body>


    </html>
