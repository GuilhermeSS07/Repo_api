<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <title>editar cadastro</title>
        <link rel="stylesheet" href="icon" type="image/png" href="/logo.png (2).png">
        <link rel="stylesheet" href="/style.css">
    </head>

     <header>
        <img class="logo" src="/logo.png (2).png" alt='logo guardalink'>
        <h1>Api Crud</h1>
        <p>Node.js + espress + ejs + MongoDB</p>
        
    </header>

    <body>
        <h2>Editar Cadastro</h2>
        <% crud.forEach(function(details) { %>
            <form action="/edit/<%= details._id %>" method="POST">
                <input type="text" value="<%= details.nomeCompleto %>" name="nomeCompleto">
                <input type="e-mail" value="<%= details.email %>" name="email">
                <br/>
                <button>
                    <a href="/show">Todos</a>
                </button>
                <button type="submit">Editar</button>
            </form>
        <% }) %>

</html>
