<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css">
    <title>Mudanças quando Necessario</title>
</head>

<body>
    <h2>Editar Registro</h2>
    <% crud.forEach(function(details) { %>
        <form action="/edit/<%= details._id %>" method="POST">
            <input type="text" value="<%= details.nome %>" name="nome">
        
            
            <br/>
            <button>
                    <a href="/show">Todos</a>
                </button>
            <button type="submit">Editar</button>
        </form>
        <% }) %>
</body>

</html>